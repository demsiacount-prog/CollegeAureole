# Copiez ce fichier en .env et renseignez vos propres valeurs.
# Ne committez jamais le fichier .env réel (déjà exclu par .gitignore).

###########################################################################
# DÉVELOPPEMENT / TESTS LOCAUX
###########################################################################
# PostgreSQL : base unique pour dev et tests E2E (le backend d'e2e resette le
# schéma public via psql avant de démarrer, Alembic recrée ensuite le schéma).
DATABASE_URL="postgresql://collegeaureole:password@localhost:5432/collegeaureole"

# Générez une clé aléatoire forte, par ex. : python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="<a-generer-avec-secrets.token_hex(32)>"

# En développement, CORS = l'origine Vite locale (+ éventuellement Tauri).
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# ENVIRONMENT="development" : le rate-limiting réseau (protection du login
# contre le bruteforce) est DÉSACTIVÉ, et le bootstrap du schéma se fait au
# démarrage. NE PAS UTILISER CES VALEURS EN PRODUCTION.
ENVIRONMENT="development"
AUTO_CREATE_TABLES="true"
LOG_LEVEL="INFO"


###########################################################################
# PRODUCTION (à DÉCOCHER / adapter AVANT de déployer)
###########################################################################
# → INSTANCES SERVEUR DE PROD : placez ces valeurs dans le .env du
#   répertoire d'installation (généré par l'installeur NSIS) ou de votre
#   environnement de déploiement. N'utilisez JAMAIS les valeurs de dev ci-dessus.
#
# 1) ENVIRONMENT="production" OBLIGATOIRE : active le rate-limiting réseau
#    (5 tentatives de connexion / min / IP) qui protège le login du
#    bruteforce. Sans cette valeur, la protection anti-bruteforce réseau
#    est désactivée.
# 2) AUTO_CREATE_TABLES="false" : appliquez les migrations manuellement et
#    de façon contrôlée (alembic upgrade head) plutôt qu'au démarrage.
# 3) CORS_ORIGINS : remplacez par les VRAIES origines de votre front
#    (ex. https://app.votre-ecole.org). Ne mettez jamais "*".
# 4) JWT_SECRET_KEY : une clé aléatoire forte (>32 octets) et JAMAIS la
#    valeur par défaut codée en dur. Ne la divulguez pas, ne la committez pas.
# 5) Derrière un reverse proxy TLS (Caddy/Nginx/Traefik) pour HTTPS ; le
#    exposant HTTP ne doit pas être exposé directement sur Internet.
#
# Exemple (à adapter) :
# ENVIRONMENT="production"
# AUTO_CREATE_TABLES="false"
# CORS_ORIGINS="https://app.votre-ecole.org"
# LOG_LEVEL="WARNING"
