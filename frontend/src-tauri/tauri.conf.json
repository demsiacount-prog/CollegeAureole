{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "College Aureole",
  "version": "1.0.0",
  "identifier": "com.college-aureole.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "College Aureole",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb"],
    "publisher": "College Aureole",
    "copyright": "© College Aureole",
    "category": "Education",
    "shortDescription": "Application de gestion scolaire",
    "longDescription": "Gestion complète d'un établissement scolaire : élèves, inscriptions, notes, paiements, bulletins.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["French"],
        "compression": "lzma",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
